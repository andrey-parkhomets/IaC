FROM ghcr.io/runatlantis/atlantis:v0.49.0-debian
USER root

RUN set -ex;\
    apt-get update ;\
    apt-get install -y apt-transport-https ca-certificates curl gnupg lsb-release;\
    mkdir -p /etc/apt/keyrings ;\
    curl -sLS https://packages.microsoft.com/keys/microsoft.asc |gpg --dearmor | tee /etc/apt/keyrings/microsoft.gpg > /dev/null ;\
    chmod go+r /etc/apt/keyrings/microsoft.gpg

# No trixie suite in the azure-cli repo yet; use bookworm like InstallAzureCLIDeb does
# https://github.com/Azure/azure-cli/issues/32069
ARG AZ_DIST=bookworm
RUN DPKG_ARCH=$(dpkg --print-architecture) \
    && cat <<EOF >/etc/apt/sources.list.d/azure-cli.sources
Types: deb
URIs: https://packages.microsoft.com/repos/azure-cli/
Suites: ${AZ_DIST}
Components: main
Architectures: ${DPKG_ARCH}
Signed-by: /etc/apt/keyrings/microsoft.gpg
EOF

ARG AZ_VER=2.91.0
#  install the CLI
RUN set -ex && \
    apt-get update && \
    apt-get install -y azure-cli=${AZ_VER}-1~${AZ_DIST} && \
    rm -rf /var/lib/apt/lists/*

# hcledit + hcl-get: read attributes (e.g. subscription_id) from backend.hcl in Atlantis workflows
ARG HCLEDIT_VER=0.2.18
RUN set -ex && \
    ARCH=$(dpkg --print-architecture) && \
    TARBALL=hcledit_${HCLEDIT_VER}_linux_${ARCH}.tar.gz && \
    cd /tmp && \
    curl -fsSLO https://github.com/minamijoyo/hcledit/releases/download/v${HCLEDIT_VER}/${TARBALL} && \
    curl -fsSL https://github.com/minamijoyo/hcledit/releases/download/v${HCLEDIT_VER}/hcledit_${HCLEDIT_VER}_checksums.txt \
      | grep " ${TARBALL}\$" | sha256sum -c - && \
    tar -xzf ${TARBALL} -C /usr/local/bin hcledit && \
    rm ${TARBALL} && \
    hcledit version

COPY --chmod=755 scripts/hcl-get /usr/local/bin/hcl-get

USER atlantis